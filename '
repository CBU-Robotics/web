.sponsors {
  width: 100%;
  padding: 40px;
  box-sizing: border-box;
  display: flex;
  flex-flow: column;
  align-items: center;
}

ul.sponsor-grid {
    list-style: none;
    width: 1020px;
    box-sizing: border-box;
    margin-bottom: 100px;
    display: flex;
    flex-wrap: wrap;
}

.sponsors h2 {
  font-size: 1.75rem;
  margin-inline: auto;
  text-align: center;
  margin-bottom: 40px;
}

.sponsors li {
    flex: 0 0 280px;
    text-align: center;
    background-color: #ffffff;
    border-radius: 4px;
    box-shadow: 0 0 4px #0001;
    width: 280px;
    height: 200px;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
}

.sponsors img {
    max-width: 40%; 
    height: auto;
    margin-bottom: 8px; 
    border-radius: 4px;
}

